# Keep admin sync DISABLED by leaving the secret blank. Configure a strong private
# secret only after reviewing WHO metadata and enabling intentional imports.
ADMIN_API_KEY=
HEALTHPULSE_DB=/app/data/healthpulse.db
# Docker Compose and the production image enable bundled verified WDI startup loading.
HEALTHPULSE_AUTOLOAD_WDI=1
# Frontend development server proxy; overridden in docker compose.
VITE_API_URL=/api
